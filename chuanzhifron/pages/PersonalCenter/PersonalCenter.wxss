@import '../index/index.wxss';

.user-card,
.section,
.quick-panel {
  position: relative;
  z-index: 1;
}

.user-card {
  background: linear-gradient(145deg, #2f2620, #1a1410);
  margin: 28rpx 24rpx 20rpx;
  border-radius: 30rpx;
  padding: 34rpx 30rpx 30rpx;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -36rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 230, 200, 0.16) 0%, transparent 70%);
}

.user-top,
.user-stats {
  position: relative;
  z-index: 1;
}

.user-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.user-header {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  border: 4rpx solid rgba(245, 230, 200, 0.7);
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #f8f0e4;
}

.user-title {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(245, 230, 200, 0.8);
}

.edit-entry {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f5e6c8;
  font-size: 24rpx;
}

.user-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.stat-item {
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}

.stat-number {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #f5e6c8;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(245, 230, 200, 0.78);
}

.quick-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.quick-item {
  background: rgba(255, 253, 251, 0.94);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(42, 34, 28, 0.06);
}

.quick-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #b83232;
}

.quick-title {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a221c;
  line-height: 1.35;
}

.section {
  margin: 0 24rpx 24rpx;
  padding: 30rpx 24rpx;
  background: rgba(255, 253, 251, 0.94);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(42, 34, 28, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2a221c;
}

.section-count {
  font-size: 23rpx;
  color: #9a928a;
}

.more-link {
  font-size: 24rpx;
  color: #b83232;
}

.empty-panel {
  padding: 28rpx 20rpx;
  text-align: center;
  background: #f7f2eb;
  border-radius: 20rpx;
  color: #968b80;
  font-size: 25rpx;
}

.collection-list,
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.collection-item,
.booking-item {
  background: #fff;
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
}

.collection-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  margin-right: 20rpx;
}

.collection-content,
.booking-content {
  flex: 1;
  min-width: 0;
}

.collection-title,
.booking-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a221c;
}

.collection-level,
.booking-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f857b;
}

.collection-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #6f665e;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.master-avatar,
.master-avatar-placeholder {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.master-avatar-placeholder {
  background: #f0e6d2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  font-size: 34rpx;
}

.booking-status {
  margin-top: 10rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  display: inline-block;
}

.booking-status.confirmed {
  background-color: rgba(76, 175, 80, 0.12);
  color: #2f8f52;
}

.booking-status.pending {
  background-color: rgba(255, 193, 7, 0.12);
  color: #bb8a00;
}

.cancel-btn {
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(19, 15, 12, 0.45);
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fffdf9;
  border-radius: 30rpx 30rpx 0 0;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2a221c;
}

.modal-close {
  font-size: 44rpx;
  color: #8f857b;
  line-height: 1;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #544b43;
}

.avatar-upload {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-preview {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.btn-upload,
.btn-cancel,
.btn-confirm {
  border: none;
}

.btn-upload {
  background: #f1e8dc;
  color: #6f5d4d;
  border-radius: 18rpx;
  font-size: 24rpx;
  padding: 0 22rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  background: #f8f3ec;
  border-radius: 20rpx;
  border: 1rpx solid rgba(139, 111, 73, 0.12);
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2a221c;
}

.form-textarea {
  min-height: 180rpx;
}

.modal-footer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  background: #f1e8dc;
  color: #6f5d4d;
  border-radius: 20rpx;
}

.btn-confirm {
  background: linear-gradient(135deg, #b83232 0%, #d3523f 100%);
  color: #fff;
  border-radius: 20rpx;
}
