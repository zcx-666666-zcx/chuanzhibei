<view class="wrap">
  <view class="card">
    <text class="tag">传承人社区 · 动态发布</text>
    <text class="title">分享一段非遗记忆</text>
    <text class="hint">记录一线手艺人的心声，将技艺背后的烟火与诗意留在数字长卷之中。</text>

    <view class="field">
      <text class="label">标题</text>
      <input class="input" placeholder="例如：苏绣针法背后的故事" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <view class="field">
      <text class="label">内容</text>
      <textarea
        class="textarea"
        placeholder="可以介绍技艺渊源、传承经历、课堂片段等，让读者在字里行间遇见非遗之美"
        value="{{content}}"
        bindinput="onContentInput"
      ></textarea>
    </view>

    <view class="field">
      <text class="label">视频链接（选填）</text>
      <input class="input" placeholder="可粘贴短视频 / 直播回放链接" value="{{videoUrl}}" bindinput="onVideoInput" />
    </view>

    <button class="btn-primary submit-btn" bindtap="onSubmit">发布到传承人社区</button>
  </view>
</view>

