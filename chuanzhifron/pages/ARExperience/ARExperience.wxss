@import '../index/index.wxss';

.overview-card {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 20rpx;
  align-items: center;
}

.overview-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #2a221c;
}

.overview-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6c635a;
}

.overview-image {
  width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
  display: block;
}

.guide-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.guide-item {
  background: linear-gradient(180deg, #fffdfb 0%, #f6efe6 100%);
  border: 1rpx solid rgba(42, 34, 28, 0.06);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
}

.guide-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 20rpx;
  background: rgba(184, 50, 50, 0.1);
  color: #b83232;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.guide-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a221c;
}

.guide-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #887f76;
}

.demo-desc {
  display: block;
  font-size: 24rpx;
  color: #7a736c;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.demo-nav {
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(42, 34, 28, 0.08);
}

.demo-nav-primary {
  background: linear-gradient(145deg, #fffdfb 0%, #f0f5fb 100%);
  box-shadow: 0 8rpx 24rpx rgba(42, 34, 28, 0.06);
}

.demo-nav-hover {
  opacity: 0.92;
}

.demo-nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a221c;
}

.demo-nav-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a928a;
  line-height: 1.5;
}

.ar-pro-hint {
  display: block;
  font-size: 26rpx;
  color: #9a928a;
  line-height: 1.5;
  padding: 8rpx 4rpx 20rpx;
}

.ar-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.ar-image-container {
  position: relative;
}

.ar-image {
  width: 100%;
  height: 240rpx;
}

.ar-content {
  padding: 24rpx;
}

.ar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2a221c;
  display: block;
  margin-bottom: 10rpx;
}

.ar-desc {
  font-size: 24rpx;
  color: #7a736c;
  line-height: 1.45;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ar-button {
  width: 100%;
  margin-top: 12rpx;
}

.no-record {
  grid-column: 1 / -1;
  text-align: center;
  padding: 48rpx 24rpx;
  color: #9a928a;
  font-size: 26rpx;
}

.footer-space {
  height: 48rpx;
}

@media (max-width: 750rpx) {
  .overview-card,
  .guide-grid,
  .ar-grid {
    grid-template-columns: 1fr;
  }
}

@import 'ARExperience-wxa-auto-dark.wxss'
