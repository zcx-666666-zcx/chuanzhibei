/* pages/activityList/activityList.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f5f2;
  padding-bottom: 160rpx;
}

/* 页面标题 */
.page-header {
  background-color: white;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 30rpx;
}

.activity-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.activity-date {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(196, 30, 58, 0.1);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.date-day {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
}

.date-month {
  font-size: 20rpx;
  color: #c41e3a;
}

.activity-content {
  flex: 1;
}

.activity-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.activity-location {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.btn-primary {
  background-color: #c41e3a;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
}

.activity-button {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
  color: #999;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.retry-btn {
  margin-top: 28rpx;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .activity-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .activity-date {
    margin-right: 0;
    margin-bottom: 20rpx;
  }
  
  .activity-button {
    width: 100%;
    margin-top: 20rpx;
  }
}

