<!-- pages/register/register.wxml -->
<view class="page">
  <view class="content">
    <view class="brand">
      <image class="logo" src="{{logoUrl}}" mode="aspectFill" binderror="onLogoError"></image>
      <text class="title">创建账号</text>
      <text class="subtitle">开启你的非遗传承之旅</text>
    </view>

    <view class="card">
      <view class="input-group">
        <text class="input-label">用户名</text>
        <input
          class="form-input"
          placeholder="2～20 位，中文、字母、数字或下划线"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="input-group">
        <text class="input-label">昵称（可选）</text>
        <input
          class="form-input"
          placeholder="不填则与用户名相同，最长 32 字"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="input-group">
        <text class="input-label">密码</text>
        <input
          class="form-input"
          placeholder="6～64 位"
          password
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="input-group">
        <text class="input-label">确认密码</text>
        <input
          class="form-input"
          placeholder="请再次输入密码"
          password
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>

      <view class="input-group">
        <text class="input-label">邮箱（可选）</text>
        <input
          class="form-input"
          placeholder="用于找回与通知"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>

      <button class="primary-btn" bindtap="onRegister" loading="{{submitting}}" disabled="{{submitting}}">
        {{submitting ? '提交中…' : '注册'}}
      </button>

      <view class="footer">
        <text class="footer-text">已有账号？</text>
        <text class="link" bindtap="goToLogin">返回登录</text>
      </view>
    </view>
  </view>

  <view class="agreement">
    <text>注册即表示您同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text>和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>
</view>
