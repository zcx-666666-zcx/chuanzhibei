.state-shell {
  margin: 40rpx 32rpx;
  padding: 44rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 253, 251, 0.98), rgba(244, 239, 232, 0.95));
  border: 1rpx solid rgba(201, 162, 39, 0.18);
  box-shadow: 0 16rpx 40rpx rgba(26, 20, 16, 0.08);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.state-shell.compact {
  margin: 24rpx 0;
  padding: 32rpx 28rpx;
}

.state-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #fffdfb;
}

.state-loading {
  background: linear-gradient(135deg, #3a6ea5, #5f8ec0);
}

.state-error {
  background: linear-gradient(135deg, #b83232, #d45757);
}

.state-empty {
  background: linear-gradient(135deg, #8c6e44, #b69261);
}

.state-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2a221c;
  line-height: 1.5;
}

.state-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6c6258;
}

.state-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.state-btn {
  margin: 0;
  border-radius: 999rpx;
  padding: 0 28rpx;
  line-height: 1.8;
}

.state-btn.primary {
  background: linear-gradient(135deg, #b83232, #d94f4f);
  color: #fffdfb;
}

.state-btn.ghost {
  background: transparent;
  color: #6c6258;
  border: 1rpx solid rgba(108, 98, 88, 0.25);
}
