/* 沉浸页 · 与首页 index 同色：纸感底、墨色顶区、白卡片 */

@import '../index/index.wxss';

.intro-inner {
  position: relative;
  z-index: 1;
}

.intro-desc {
  font-size: 28rpx;
  color: #5a524a;
  line-height: 1.65;
  display: block;
  margin-bottom: 20rpx;
}

.intro-features {
  font-size: 28rpx;
  color: #2a221c;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.feature-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.feature-text {
  font-size: 26rpx;
  color: #6a625a;
  flex: 1;
}

.intro-image {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  display: block;
}

.ar-pro-hint {
  display: block;
  font-size: 26rpx;
  color: #9a928a;
  line-height: 1.5;
  padding: 8rpx 4rpx 20rpx;
}

.guide-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.guide-item {
  text-align: center;
}

.guide-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #fff9f5, #ffe8dc);
  border: 1rpx solid rgba(184, 50, 50, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.guide-icon .iconfont {
  font-size: 36rpx;
  color: #b83232;
}

.guide-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2a221c;
  display: block;
  margin-bottom: 8rpx;
}

.guide-desc {
  font-size: 22rpx;
  color: #9a928a;
  line-height: 1.4;
}

.ar-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.ar-image-container {
  position: relative;
}

.ar-image {
  width: 100%;
  height: 240rpx;
}

.ar-content {
  padding: 24rpx;
}

.ar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2a221c;
  display: block;
  margin-bottom: 10rpx;
}

.ar-desc {
  font-size: 24rpx;
  color: #7a736c;
  line-height: 1.45;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ar-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.no-record {
  grid-column: 1 / -1;
  text-align: center;
  padding: 48rpx 24rpx;
  color: #9a928a;
  font-size: 26rpx;
}

.footer-space {
  height: 48rpx;
}

.demo-desc {
  display: block;
  font-size: 24rpx;
  color: #7a736c;
  line-height: 1.55;
  margin-bottom: 24rpx;
}

.demo-nav {
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(42, 34, 28, 0.08);
}

.demo-nav-primary {
  background: linear-gradient(145deg, #fffdfb 0%, #f7f0e8 100%);
  box-shadow: 0 8rpx 24rpx rgba(42, 34, 28, 0.06);
}

.demo-nav-secondary {
  background: linear-gradient(145deg, #faf8f5 0%, #f0ebe4 100%);
  box-shadow: 0 8rpx 24rpx rgba(42, 34, 28, 0.05);
}

.demo-nav-hover {
  opacity: 0.92;
}

.demo-nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a221c;
  margin-bottom: 8rpx;
}

.demo-nav-sub {
  font-size: 24rpx;
  color: #9a928a;
  line-height: 1.4;
}

.iconfont {
  font-size: 32rpx;
}

.icon-mobile::before {
  content: '📱';
}

.icon-camera::before {
  content: '📷';
}

.icon-hand::before {
  content: '👆';
}

@media (max-width: 750rpx) {
  .ar-grid {
    grid-template-columns: 1fr;
  }

  .guide-grid {
    grid-template-columns: 1fr;
    gap: 28rpx;
  }
}
