<!-- 沉浸体验 · 与首页同色纸感 -->
<view class="page">
  <view class="bg-layer" aria-hidden="true"></view>

  <view class="hero">
    <view class="hero-deco" aria-hidden="true"></view>
    <view class="hero-inner">
      <text class="hero-kicker">IMMERSIVE · AR / VR</text>
      <text class="hero-title">沉浸体验</text>
      <text class="hero-sub">对准识别图或平面，在实景画面中叠加讲解与细节（可后续扩展 VR 全景）</text>
    </view>
  </view>

  <view class="sheet sheet-tight">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">INTRO</text>
        <text class="sheet-cn">什么是文物 沉浸 体验</text>
      </view>
    </view>
    <view class="intro-inner">
      <text class="intro-desc">对准指定的文物图片（Marker），在真实画面上叠加播放文物的讲解视频与细节画面，让文物在光影中徐徐「活」起来。</text>
      <text class="intro-features">您可以：</text>
      <view class="feature-list">
        <view class="feature-item">
          <text class="feature-icon">🔍</text>
          <text class="feature-text">在真实场景中观看文物细节视频</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">👆</text>
          <text class="feature-text">对准海报/展板即可触发 沉浸 叠加</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">📖</text>
          <text class="feature-text">聆听文物背后的历史与工艺故事</text>
        </view>
      </view>
      <image src="{{arPlaceholderImage}}" class="intro-image" mode="aspectFill" lazy-load="{{true}}"></image>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">GUIDE</text>
        <text class="sheet-cn">体验指南</text>
      </view>
    </view>
    <view class="guide-grid">
      <view class="guide-item">
        <view class="guide-icon">
          <text class="iconfont icon-mobile">📱</text>
        </view>
        <text class="guide-title">打开小程序</text>
        <text class="guide-desc">确保设备支持并已授予相机权限</text>
      </view>
      <view class="guide-item">
        <view class="guide-icon">
          <text class="iconfont icon-camera">📷</text>
        </view>
        <text class="guide-title">扫描识别</text>
        <text class="guide-desc">将相机对准识别图或平面</text>
      </view>
      <view class="guide-item">
        <view class="guide-icon">
          <text class="iconfont icon-hand">👆</text>
        </view>
        <text class="guide-title">互动体验</text>
        <text class="guide-desc">在屏幕上进行缩放与查看</text>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">DEMO</text>
        <text class="sheet-cn">3D 沉浸演示</text>
      </view>
    </view>
    <text class="demo-desc">基于微信 xr-frame：展台场景 + 服务端 uploads/3D 目录下的自有 glb（经卷轴筒、石碑、景泰蓝花瓶等）+ 多光源与阴影。单指旋转视角，双指缩放。</text>
    <navigator url="/pages/xrDemo3D/xrDemo3D" class="demo-nav demo-nav-primary" hover-class="demo-nav-hover">
      <text class="demo-nav-title">进入 3D 演示</text>
      <text class="demo-nav-sub">页内可切换模型</text>
    </navigator>
  </view>

  <view class="sheet">
    <view class="sheet-head row-between">
      <view class="sheet-head-left">
        <text class="sheet-en">PROJECTS</text>
        <text class="sheet-cn">沉浸 体验项目</text>
      </view>
      <text class="sheet-more" bindtap="goARProjectListFull">全部</text>
    </view>
    <text wx:if="{{loading}}" class="ar-pro-hint">项目加载中…</text>
    <text wx:elif="{{!arProjects.length}}" class="ar-pro-hint">暂无项目，可下拉刷新或从首页进入「AR 项目列表」</text>
    <scroll-view wx:else class="pick-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="pick-track">
        <view
          class="pick-card"
          wx:for="{{arProjects}}"
          wx:key="id"
          bindtap="onArProjectTap"
          data-item="{{item}}"
        >
          <image src="{{item.coverImage}}" class="pick-img" mode="aspectFill" lazy-load="{{true}}"></image>
          <view class="pick-body">
            <text class="pick-name">{{item.name}}</text>
            <text class="pick-region">轻点进入相机体验</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="sheet">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">HISTORY</text>
        <text class="sheet-cn">我的体验记录</text>
      </view>
    </view>
    <view class="ar-grid">
      <view class="ar-card card card-hover"
            wx:for="{{experienceRecords}}"
            wx:key="id"
            wx:if="{{experienceRecords.length > 0}}">
        <view class="ar-image-container">
          <video
            id="record-preview-video-{{index}}"
            class="ar-image"
            src="{{item.videoUrl}}"
            poster="{{item.image || arPlaceholderImage}}"
            object-fit="cover"
            controls="{{false}}"
            show-center-play-btn="{{false}}"
            show-play-btn="{{false}}"
            show-fullscreen-btn="{{false}}"
            enable-progress-gesture="{{false}}"
            loop="{{false}}"
            muted="{{true}}"
            preload="{{videoPreload}}"
            bindloadedmetadata="onRecordPreviewMetaLoaded"
            data-index="{{index}}"
          ></video>
        </view>
        <view class="ar-content">
          <text class="ar-title">{{item.name}}</text>
          <text class="ar-desc">体验时间：{{item.time}}</text>
          <text class="ar-desc">时长：{{item.duration}}</text>
          <button class="btn-secondary ar-button" bindtap="replayExperience" data-item="{{item}}" catchtap="true">
            <text>重新体验</text>
          </button>
        </view>
      </view>
      <view wx:if="{{experienceRecords.length === 0}}" class="no-record">
        <text>暂无体验记录</text>
      </view>
    </view>
  </view>

  <view class="footer-space"></view>
</view>
