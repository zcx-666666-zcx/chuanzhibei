/* PersonalCenter.wxss */
 .container {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #e8dfd4 0%, #f4efe8 50%, #f8f6f2 100%);
  overflow-x: hidden;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(145deg, #2f2620, #1a1410);
  margin: 28rpx 30rpx 24rpx;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 34rpx;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 230, 200, 0.16) 0%, transparent 70%);
}

.user-card:active {
  transform: scale(0.98);
  transition: all 0.18s ease-out;
}

.user-card::after {
  content: '✒';
  position: absolute;
  top: 38rpx;
  right: 34rpx;
  font-size: 30rpx;
  opacity: 0.45;
  color: #f5e6c8;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(245, 230, 200, 0.7);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #f8f0e4;
  display: block;
  margin-bottom: 8rpx;
}

.user-title {
  font-size: 28rpx;
  color: rgba(245, 230, 200, 0.8);
  display: block;
}

.settings-btn {
  background: none;
  border: none;
  padding: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.settings-btn:active {
  color: #c41e3a;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 6rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #f5e6c8;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(245, 230, 200, 0.78);
  display: block;
}

/* 区块样式 */
.section {
  margin-bottom: 40rpx;
  padding: 0 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-bottom: 12rpx;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 60rpx;
  height: 4rpx;
  background-color: #c41e3a;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.more-link {
  font-size: 28rpx;
  color: #c41e3a;
}

/* 传承人社区卡片 */
.community-card {
  margin: 0 30rpx 20rpx;
  padding: 32rpx 28rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #fffdfb 0%, #f4ebe3 100%);
  box-shadow: 0 12rpx 32rpx rgba(42, 34, 28, 0.08);
}

.community-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(184, 50, 50, 0.08);
  color: #b83232;
  margin-bottom: 14rpx;
}

.community-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2a221c;
  margin-bottom: 10rpx;
}

.community-desc {
  display: block;
  font-size: 26rpx;
  color: #6a625a;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.community-actions {
  margin-top: 8rpx;
}

.community-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(90, 143, 58, 0.1);
  color: #5a8f3a;
  margin-bottom: 18rpx;
}

.community-row {
  display: flex;
  gap: 16rpx;
}

.community-btn,
.community-btn-half {
  margin-top: 4rpx;
}

.community-btn-half {
  flex: 1;
}

/* 收藏列表 */
.collection-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.collection-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.collection-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.collection-content {
  flex: 1;
}

.collection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.collection-level {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.collection-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.remove-btn {
  background: none;
  border: none;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.remove-btn:active {
  color: #c41e3a;
}


/* 预约列表 */
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.booking-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.master-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.master-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0e6d2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  font-size: 36rpx;
}

.booking-content {
  flex: 1;
}

.booking-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.booking-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.booking-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  display: inline-block;
}

.booking-status.confirmed {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4caf50;
}

.booking-status.pending {
  background-color: rgba(255, 193, 7, 0.1);
  color: #ffc107;
}

.cancel-btn {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 功能菜单 */
.menu-section {
  background: white;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 40rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 图标字体 */
.iconfont {
  font-size: 32rpx;
}

.icon-settings::before {
  content: '⚙️';
}

.icon-close::before {
  content: '✕';
}

/* 修改个人信息弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 24rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 40rpx;
  flex: 1;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fafafa;
}

.form-input:focus {
  border-color: #c41e3a;
  background-color: white;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fafafa;
}

.form-textarea:focus {
  border-color: #c41e3a;
  background-color: white;
}

.avatar-upload {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
}

.btn-upload {
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 12rpx;
  border: none;
}

.btn-upload:active {
  background-color: #e0e0e0;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 40rpx;
  border-top: 2rpx solid #f5f5f5;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn-cancel:active {
  background-color: #e0e0e0;
}

.btn-confirm {
  background-color: #c41e3a;
  color: white;
}

.btn-confirm:active {
  background-color: #a01a2e;
}


/* 响应式调整 */
@media (max-width: 750rpx) {
  .collection-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .collection-image {
    width: 100%;
    height: 200rpx;
    margin-right: 0;
    margin-bottom: 20rpx;
  }
  
  .booking-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .master-avatar {
    margin-right: 0;
    margin-bottom: 20rpx;
  }
  
  .cancel-btn {
    width: 100%;
    margin-top: 20rpx;
  }
}
