/* pages/bookingList/bookingList.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f5f2;
  padding: 0 30rpx 40rpx;
}

.page-header {
  padding: 30rpx 0;
  background-color: #fff;
  margin: 0 -30rpx 30rpx -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-bottom: 16rpx;
}

.page-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background-color: #c41e3a;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 预约列表 */
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.booking-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.master-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.master-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0e6d2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-placeholder-icon {
  font-size: 36rpx;
}

.booking-content {
  flex: 1;
}

.booking-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.booking-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.booking-location {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.booking-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  display: inline-block;
}

.booking-status.confirmed {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4caf50;
}

.booking-status.pending {
  background-color: rgba(255, 193, 7, 0.1);
  color: #ffc107;
}

.booking-status.cancelled {
  background-color: rgba(158, 158, 158, 0.1);
  color: #9e9e9e;
}

.cancel-btn {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
  margin-left: 20rpx;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .booking-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .master-avatar {
    margin-right: 0;
    margin-bottom: 20rpx;
  }
  
  .cancel-btn {
    width: 100%;
    margin-left: 0;
    margin-top: 20rpx;
  }
}

