/* pages/ARProjectList/ARProjectList.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f5f2;
  padding: 0 30rpx 40rpx;
}

.page-header {
  padding: 30rpx 0;
  background-color: #fff;
  margin: 0 -30rpx 30rpx -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-bottom: 16rpx;
}

.page-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background-color: #c41e3a;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* AR项目网格 */
.ar-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.ar-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.ar-image-container {
  position: relative;
}

.ar-image {
  width: 100%;
  height: 240rpx;
}

.hot-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #c41e3a;
  color: white;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.ar-content {
  padding: 24rpx;
}

.ar-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.ar-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ar-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.ar-button text {
  font-size: 28rpx;
}

/* 图标字体 */
.iconfont {
  font-size: 32rpx;
}

.icon-cube::before {
  content: '📦';
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .ar-grid {
    grid-template-columns: 1fr;
  }
}

