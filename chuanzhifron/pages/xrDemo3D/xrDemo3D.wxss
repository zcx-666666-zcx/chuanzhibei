.xr-wrap {
  width: 100%;
  height: 100vh;
  background: #1a1410;
}

.xr-gate {
  height: 100%;
  padding: 56rpx 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 18rpx;
  color: #f3e8da;
}

.xr-title {
  font-size: 40rpx;
  font-weight: 700;
}

.xr-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.xr-tip {
  font-size: 22rpx;
  color: #f7c08a;
}

.xr-hint {
  font-size: 22rpx;
  color: #d9c9b5;
}

.xr-picker-wrap {
  width: 90%;
}

.xr-picker {
  border: 1rpx solid rgba(243, 232, 218, 0.35);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #f3e8da;
  background: rgba(243, 232, 218, 0.08);
}

.xr-picker-fixed {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 99;
}

.xr-picker-fixed-inner {
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
}

.xr-btn {
  margin-top: 16rpx;
  width: 70%;
  background: #b83232;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}
