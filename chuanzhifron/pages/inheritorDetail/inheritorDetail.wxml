<view class="container">
  <app-state
    wx:if="{{loading}}"
    type="loading"
    title="传承人信息加载中"
    description="正在准备传承人简介与技能资料。"
  />

  <app-state
    wx:elif="{{loadError}}"
    type="error"
    title="传承人信息加载失败"
    description="{{loadErrorText || '请稍后重试'}}"
    actionText="重新加载"
    bind:action="onRetryLoad"
  />

  <view wx:else class="detail-card">
    <image class="avatar" src="{{inheritor.avatar}}" mode="aspectFill"></image>
    <view class="meta">
      <text class="name">{{inheritor.name}}</text>
      <text class="title">{{inheritor.title || inheritor.level || '传承人'}}</text>
      <text class="skill">{{inheritor.skill}}</text>
    </view>
    <view class="intro-box">
      <text class="intro-title">传承人简介</text>
      <text class="intro-content">{{inheritor.introduction}}</text>
    </view>
  </view>
</view>
