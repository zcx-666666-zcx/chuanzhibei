<!--pages/activityList/activityList.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">近期活动</text>
  </view>

  <app-state
    wx:if="{{loading}}"
    type="loading"
    title="活动列表加载中"
    description="正在获取近期活动与可报名场次。"
  />

  <app-state
    wx:elif="{{loadError}}"
    type="error"
    title="活动列表加载失败"
    description="{{loadErrorText || '请检查网络后重试'}}"
    actionText="重新加载"
    bind:action="onRetryLoadActivities"
  />

  <view wx:else class="activity-list">
    <view class="activity-item" wx:for="{{activities}}" wx:key="id">
      <view class="activity-date">
        <text class="date-day">{{item.day}}</text>
        <text class="date-month">{{item.month}}</text>
      </view>
      <view class="activity-content">
        <text class="activity-title">{{item.title}}</text>
        <text class="activity-time">{{item.time}}</text>
        <text class="activity-location">{{item.location}}</text>
      </view>
      <button class="btn-primary activity-button" bindtap="joinActivity" data-item="{{item}}">
        {{item.buttonText}}
      </button>
    </view>
  </view>

  <app-state
    wx:if="{{!loading && !loadError && activities.length === 0}}"
    type="empty"
    title="暂无活动信息"
    description="当前还没有可展示的近期活动。"
  />
</view>
