.xr-wrap {
  width: 100%;
  height: 100vh;
  background: #ebe8df;
}

.xr-wrap--pure {
  background: #ebe8df;
}

.xr-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.xr-loading-text {
  font-size: 28rpx;
  color: #6b6560;
  padding: 0 48rpx;
  text-align: center;
}
