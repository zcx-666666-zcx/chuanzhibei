/* index.wxss · 首页视觉：纸感、墨色、朱砂点缀、清晰层级 */

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.bg-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 520rpx;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 120% 80% at 10% -10%, rgba(184, 50, 50, 0.12) 0%, transparent 55%),
    radial-gradient(ellipse 80% 60% at 90% 20%, rgba(201, 162, 39, 0.08) 0%, transparent 50%),
    linear-gradient(180deg, #ebe4d9 0%, #f4efe8 55%, #f4efe8 100%);
}

/* —— 顶区 —— */
.hero {
  position: relative;
  z-index: 1;
  margin: 24rpx 24rpx 0;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(155deg, #2f2620 0%, #1a1410 48%, #3d2e26 100%);
  box-shadow:
    0 24rpx 56rpx rgba(26, 20, 16, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.hero-deco {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 230, 200, 0.12) 0%, transparent 70%);
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 230, 200, 0.45);
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 20rpx;
  color: #f8f0e4;
  line-height: 1.1;
  margin-bottom: 12rpx;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.hero-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(245, 230, 200, 0.78);
  line-height: 1.5;
  max-width: 92%;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #3d2c24;
  background: linear-gradient(180deg, #f5e6c8 0%, #e8d4b8 100%);
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.hero-pill.ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #f5e6c8;
  border: 1rpx solid rgba(245, 230, 200, 0.35);
  box-shadow: none;
}

.hero-pill::after {
  border: none;
}

.hero-pill-ico {
  font-size: 28rpx;
  opacity: 0.9;
}

/* —— 白卡片容器 —— */
.sheet {
  position: relative;
  z-index: 1;
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx 36rpx;
  background: rgba(255, 253, 251, 0.94);
  border-radius: 28rpx;
  border: 1rpx solid rgba(42, 34, 28, 0.05);
  box-shadow: 0 16rpx 48rpx rgba(42, 34, 28, 0.06);
}

.sheet-tight {
  margin-top: -20rpx;
  padding-top: 36rpx;
}

.sheet-flush {
  padding: 0;
  overflow: hidden;
}

.sheet-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.sheet-head.row-between {
  align-items: center;
}

.sheet-head-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sheet-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #b83232;
  font-weight: 600;
}

.sheet-cn {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a221c;
}

.sheet-tip {
  font-size: 22rpx;
  color: #9a928a;
}

.sheet-more {
  font-size: 26rpx;
  color: #b83232;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(184, 50, 50, 0.08);
}

.sheet-more-hover {
  opacity: 0.85;
}

/* —— 寻迹导航 3×3 —— */
.diamond-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx 14rpx;
}

.diamond-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 16rpx 4rpx 12rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fffdfb 0%, #f7f2eb 100%);
  border: 1rpx solid rgba(42, 34, 28, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(42, 34, 28, 0.04);
  transition: transform 0.15s ease;
}

.diamond-item:active {
  transform: scale(0.96);
}

.diamond-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-bottom: 10rpx;
}

.bg-a { background: linear-gradient(145deg, #ffe8e0, #ffd0c4); }
.bg-b { background: linear-gradient(145deg, #e8f0ff, #d4e4ff); }
.bg-c { background: linear-gradient(145deg, #f0ebe3, #e5ddd2); }
.bg-d { background: linear-gradient(145deg, #fdeee8, #f5d5c8); }
.bg-e { background: linear-gradient(145deg, #eaf6f0, #d5ebe0); }
.bg-f { background: linear-gradient(145deg, #f5eef8, #e8dcf0); }
.bg-g { background: linear-gradient(145deg, #fff0e0, #ffd9b8); }
.bg-h { background: linear-gradient(145deg, #e8f4ff, #cce8ff); }
.bg-i { background: linear-gradient(145deg, #fff5e6, #ffe0c2); }
.bg-j { background: linear-gradient(145deg, #f0f4ff, #dce4ff); }
.bg-k { background: linear-gradient(145deg, #fdf0f5, #f5d5e4); }
.bg-l { background: linear-gradient(145deg, #f0fff4, #d5f0dd); }
.bg-m { background: linear-gradient(145deg, #fff0f0, #ffd6d6); }
.bg-n { background: linear-gradient(145deg, #f5f5f0, #e8e8e0); }
.bg-o { background: linear-gradient(145deg, #faf8f0, #eee6d8); }
.bg-p { background: linear-gradient(145deg, #eef0f5, #dde0eb); }

.diamond-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #2a221c;
  line-height: 1.25;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.diamond-sub {
  font-size: 18rpx;
  color: #9a928a;
  margin-top: 4rpx;
  line-height: 1.2;
}

/* —— 路线横向滚动 —— */
.route-scroll {
  width: 100%;
  white-space: nowrap;
}

.route-track {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 4rpx 12rpx;
}

.route-card {
  flex-shrink: 0;
  width: 280rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(42, 34, 28, 0.08);
}

.route-card:active {
  opacity: 0.92;
}

.route-card.r1 {
  background: linear-gradient(160deg, #fff9f5 0%, #ffe8dc 100%);
  border: 1rpx solid rgba(184, 50, 50, 0.12);
}

.route-card.r2 {
  background: linear-gradient(160deg, #f8fffb 0%, #dff5ea 100%);
  border: 1rpx solid rgba(60, 120, 90, 0.15);
}

.route-card.r3 {
  background: linear-gradient(160deg, #faf8ff 0%, #ebe4ff 100%);
  border: 1rpx solid rgba(100, 80, 160, 0.12);
}

.route-card.r4 {
  background: linear-gradient(160deg, #fff8f0 0%, #ffe4c4 100%);
  border: 1rpx solid rgba(180, 100, 40, 0.15);
}

.route-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  color: #b83232;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.route-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2a221c;
  margin-bottom: 10rpx;
  white-space: normal;
}

.route-path {
  display: block;
  font-size: 22rpx;
  color: #7a736c;
  line-height: 1.4;
  white-space: normal;
}

/* —— 轮播 —— */
.hero-swiper {
  height: 380rpx;
}

.swiper-card {
  position: relative;
  height: 100%;
  margin: 0 28rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(26, 20, 16, 0.18);
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.swiper-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 65%;
  background: linear-gradient(to top, rgba(15, 12, 10, 0.88), transparent);
}

.swiper-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 32rpx 32rpx;
}

.swiper-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #f8f0e4;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.swiper-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(245, 230, 200, 0.88);
  line-height: 1.45;
}

/* —— 资讯 左图右文 —— */
.article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.article-row {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid rgba(42, 34, 28, 0.05);
  box-shadow: 0 8rpx 28rpx rgba(42, 34, 28, 0.05);
}

.article-row:active {
  opacity: 0.96;
}

.article-cover {
  width: 220rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #eee;
}

.article-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a221c;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-lead {
  font-size: 24rpx;
  color: #7a736c;
  margin-top: 8rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.article-date {
  font-size: 22rpx;
  color: #a09890;
}

.article-byline {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #a09890;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-loading {
  padding: 48rpx 24rpx;
  text-align: center;
}

.article-loading-text {
  font-size: 26rpx;
  color: #9a928a;
}

.article-empty {
  padding: 48rpx 28rpx 56rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx dashed rgba(42, 34, 28, 0.12);
}

.article-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a221c;
  margin-bottom: 12rpx;
}

.article-empty-hint {
  display: block;
  font-size: 24rpx;
  color: #9a928a;
  line-height: 1.5;
}

.article-empty-link {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #b83232;
  font-weight: 500;
}

.article-go {
  font-size: 22rpx;
  color: #b83232;
  font-weight: 500;
}

/* —— 精选横向 —— */
.pick-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 0 -8rpx;
}

.pick-track {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 8rpx 16rpx;
}

.pick-card {
  flex-shrink: 0;
  width: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(42, 34, 28, 0.08);
}

.pick-card:active {
  transform: scale(0.98);
}

.pick-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.pick-body {
  padding: 20rpx 16rpx 22rpx;
}

.pick-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2a221c;
  margin-bottom: 6rpx;
  white-space: normal;
}

.pick-region {
  display: block;
  font-size: 22rpx;
  color: #9a928a;
  white-space: normal;
}

/* —— AR —— */
.ar-cta {
  position: relative;
  z-index: 1;
  margin: 28rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  min-height: 200rpx;
  box-shadow: 0 20rpx 48rpx rgba(92, 26, 26, 0.35);
}

.ar-cta:active {
  opacity: 0.97;
}

.ar-cta-bg {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(125deg, rgba(60, 20, 20, 0.95) 0%, rgba(120, 40, 40, 0.88) 45%, rgba(40, 20, 25, 0.92) 100%);
}

.ar-cta-bg::after {
  content: '';
  position: absolute;
  right: -20%;
  top: -40%;
  width: 70%;
  height: 140%;
  background: radial-gradient(circle, rgba(245, 230, 200, 0.15) 0%, transparent 65%);
}

.ar-cta-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}

.ar-cta-text {
  flex: 1;
  min-width: 0;
}

.ar-cta-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 230, 200, 0.55);
  margin-bottom: 8rpx;
}

.ar-cta-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #f8f0e4;
  margin-bottom: 10rpx;
}

.ar-cta-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(245, 230, 200, 0.78);
  line-height: 1.45;
}

.ar-cta-btn {
  flex-shrink: 0;
  padding: 22rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5c1a1a;
  background: linear-gradient(180deg, #f5e6c8, #e8d4b8);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.footer-space {
  height: 48rpx;
}

@import 'index-wxa-auto-dark.wxss'
