.wrap {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: linear-gradient(180deg, #e8dfd4 0%, #f4efe8 100%);
  box-sizing: border-box;
}

.card {
  background: rgba(255, 253, 251, 0.96);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(42, 34, 28, 0.12);
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(184, 50, 50, 0.08);
  color: #b83232;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #2a221c;
  margin-bottom: 12rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #7a736c;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #4a423a;
  margin-bottom: 10rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid #e0d6c8;
  background: #f9f4ed;
  font-size: 26rpx;
  color: #2a221c;
}

.textarea {
  min-height: 200rpx;
}

.submit-btn {
  margin-top: 10rpx;
  border-radius: 999rpx;
}

