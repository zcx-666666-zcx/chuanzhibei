<view class="container">
  <app-state
    wx:if="{{loading}}"
    type="loading"
    title="沉浸项目加载中"
    description="正在准备演示素材、讲解视频与体验说明。"
  />

  <app-state
    wx:elif="{{loadFailed}}"
    type="error"
    title="沉浸项目加载失败"
    description="{{loadErrorText}}"
    actionText="重新加载"
    bind:action="onRetryLoadProject"
  />

  <block wx:else>
    <view class="header">
      <text class="title">{{project.name}}</text>
      <text class="desc">{{project.description}}</text>
    </view>

    <view class="card">
      <text class="card-title">演示提示</text>
      <text class="card-text">当前页面用于承接你已录制的讲解视频和项目展示素材，适合作为沉浸内容说明页继续保留。</text>
      <text wx:if="{{!project.videoUrl}}" class="card-warn">暂无讲解视频地址；如后台已补充素材，请重新进入本页查看。</text>
      <video wx:if="{{project.videoUrl}}"
             id="ar-play-preview-video"
             src="{{project.videoUrl}}"
             class="marker-img"
             poster="{{project.markerImage || arPlaceholderImage}}"
             controls="{{false}}"
             show-center-play-btn="{{false}}"
             show-play-btn="{{false}}"
             show-fullscreen-btn="{{false}}"
             enable-progress-gesture="{{false}}"
             loop="{{false}}"
             muted="{{true}}"
             preload="{{videoPreload}}"
             object-fit="cover"
             bindloadedmetadata="onPlayPreviewMetaLoaded">
      </video>
      <image wx:elif="{{project.markerImage}}" src="{{project.markerImage}}" class="marker-img" mode="aspectFill" lazy-load="{{true}}"></image>
      <image wx:else src="{{arPlaceholderImage}}" class="marker-img" mode="aspectFill" lazy-load="{{true}}"></image>
    </view>

    <view class="card">
      <text class="card-title">体验指南</text>
      <block wx:for="{{instructionLines}}" wx:key="index">
        <text class="card-text">{{item}}</text>
      </block>
    </view>

    <view class="footer">
      <button class="btn-primary" bindtap="startCamera">开始讲解演示</button>
    </view>

    <view wx:if="{{arRecognitionActive}}" class="ar-overlay">
      <view class="ar-result">
        <text class="result-text">演示开始，正在播放讲解视频...</text>
        <video wx:if="{{project.videoUrl}}" 
               src="{{project.videoUrl}}" 
               controls 
               autoplay 
               class="video" 
               poster="{{project.markerImage || project.coverImage || arPlaceholderImage}}"
               show-center-play-btn="{{false}}"
               show-play-btn="{{false}}"
               enable-danmu="{{false}}"
               enable-play-gesture="{{false}}"
               vslide-gesture="{{false}}"
               vslide-gesture-in-fullscreen="{{false}}"
               picture-in-picture="{{false}}"
               preload="{{videoPreload}}">
        </video>
      </view>
    </view>
  </block>
</view>
