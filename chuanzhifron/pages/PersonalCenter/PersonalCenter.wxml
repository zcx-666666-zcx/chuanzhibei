<!--PersonalCenter.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card" bindtap="onUserCardTap">
    <view class="user-header">
      <image src="{{userInfo.avatar}}" class="user-avatar" mode="aspectFill" binderror="onAvatarError"></image>
      <view class="user-info">
        <text class="user-name">{{userInfo.name || '访客'}}</text>
        <text class="user-title">{{userInfo.title || '非遗文化爱好者'}}</text>
      </view>
    </view>
    
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-number">{{userStats.collections}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{userStats.bookings}}</text>
        <text class="stat-label">预约体验</text>
      </view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的收藏</text>
      <view class="section-header-right" wx:if="{{collections.length > 3}}">
        <text class="section-count">{{collections.length}}项</text>
        <navigator url="/pages/collectionList/collectionList" class="more-link">查看更多</navigator>
      </view>
    </view>
    <view class="collection-list">
      <view class="collection-item" wx:for="{{displayCollections}}" wx:key="id" bindtap="onCollectionTap" data-item="{{item}}">
        <image src="{{item.image || item.imageUrl || 'https://picsum.photos/seed/collection-'+index+'/360/240'}}" class="collection-image" mode="aspectFill"></image>
        <view class="collection-content">
          <text class="collection-title">{{item.name || item.heritageName}}</text>
          <text class="collection-level">{{item.level || item.heritageLevel}}</text>
          <text class="collection-desc">{{item.description || item.heritageDescription}}</text>
        </view>
        
      </view>
    </view>
  </view>

  <!-- 预约体验 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">预约体验</text>
      <text class="more-link" bindtap="viewAllBookings">查看全部</text>
    </view>
    <view class="booking-list">
      <view class="booking-item" wx:for="{{bookings}}" wx:key="id">
        <image wx:if="{{item.masterAvatar}}" src="{{item.masterAvatar || 'https://picsum.photos/seed/booking-'+index+'/200/200'}}" class="master-avatar" mode="aspectFill"></image>
        <view wx:else class="master-avatar-placeholder">
          <text class="avatar-placeholder-icon">{{item.type === 'activity' ? '📅' : (item.type === 'watch' ? '👁' : '👤')}}</text>
        </view>
        <view class="booking-content">
          <text class="booking-title">{{item.masterName}}{{item.skill ? ' - ' + item.skill : ''}}</text>
          <text class="booking-time">{{item.time}}</text>
          <text class="booking-status {{item.status}}">{{item.statusText}}</text>
        </view>
        <button wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" class="btn-secondary cancel-btn" bindtap="cancelBooking" data-item="{{item}}">
          取消预约
        </button>
      </view>
    </view>
  </view>

  <!-- 传承人认证与社区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">传承人社区</text>
    </view>
    <view class="community-card">
      <view class="community-badge">重要展示模块</view>
      <text class="community-title">成为非遗传承人，加入社区创作</text>
      <text class="community-desc">
        通过认证后，可以在「传承人社区」发布非遗记忆文章、技艺视频，与公众和学员建立长期联系。
      </text>

      <view wx:if="{{!isInheritor}}">
        <button class="btn-primary community-btn" bindtap="applyAsInheritor">申请成为非遗传承人</button>
      </view>

      <view wx:if="{{isInheritor}}" class="community-actions">
        <view class="community-tag">已认证传承人</view>
        <view class="community-row">
          <button class="btn-secondary community-btn-half" bindtap="goInheritorCommunity">进入传承人社区</button>
          <button class="btn-primary community-btn-half" bindtap="goInheritorPost">发布社区动态</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 修改个人信息弹窗 -->
  <view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">修改个人信息</text>
        <text class="modal-close" bindtap="closeEditModal">×</text>
      </view>
      
      <view class="modal-body">
        <!-- 头像选择 -->
        <view class="form-item">
          <text class="form-label">头像</text>
          <view class="avatar-upload">
            <image src="{{editForm.avatar || userInfo.avatar}}" class="avatar-preview" mode="aspectFill"></image>
            <button class="btn-upload" bindtap="chooseAvatar">选择头像</button>
          </view>
        </view>
        
        <!-- 用户名称 -->
        <view class="form-item">
          <text class="form-label">用户名称</text>
          <input class="form-input" placeholder="请输入用户名称" value="{{editForm.name}}" bindinput="onNameInput" />
        </view>
        
        <!-- 个人签名 -->
        <view class="form-item">
          <text class="form-label">个人签名</text>
          <textarea class="form-textarea" placeholder="请输入个人签名" value="{{editForm.signature}}" bindinput="onSignatureInput" maxlength="50"></textarea>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-confirm" bindtap="saveUserInfo">保存</button>
      </view>
    </view>
  </view>

</view>
