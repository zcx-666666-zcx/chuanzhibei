<!--pages/bookingList/bookingList.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">预约体验</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 预约列表 -->
  <view wx:else class="booking-list">
    <view class="booking-item card card-hover" 
          wx:for="{{bookings}}" 
          wx:key="id" 
          bindtap="viewBookingDetail" 
          data-item="{{item}}">
      <image wx:if="{{item.masterAvatar}}" src="{{item.masterAvatar}}" class="master-avatar" mode="aspectFill"></image>
      <view wx:else class="master-avatar-placeholder">
        <text class="avatar-placeholder-icon">{{item.type === 'activity' ? '📅' : (item.type === 'watch' ? '👁' : '👤')}}</text>
      </view>
      <view class="booking-content">
        <text class="booking-title">{{item.masterName}}{{item.skill ? ' - ' + item.skill : ''}}</text>
        <text class="booking-time">{{item.time}}</text>
        <text class="booking-location">{{item.location}}</text>
        <text class="booking-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <button wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" 
              class="btn-secondary cancel-btn" 
              bindtap="cancelBooking" 
              data-item="{{item}}" 
              catchtap="true">
        取消预约
      </button>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && bookings.length === 0}}" class="empty-state">
    <text>暂无预约记录</text>
  </view>
</view>

