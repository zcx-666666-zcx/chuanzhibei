<!--index.wxml · 首页：遗韵长卷-->
<view class="page">
  <view class="bg-layer" aria-hidden="true"></view>

  <!-- 顶区：品牌 -->
  <view class="hero" style="height: 379rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">
    <view class="hero-deco" aria-hidden="true"></view>
    <view class="hero-inner">
      <text class="hero-kicker">CHUANZHI CUP · DIGITAL HERITAGE</text>
      <text class="hero-title">传智杯</text>
      <text class="hero-sub">以更完整的内容组织、沉浸展示与用户互动，呈现非遗项目的真实价值与传播路径。</text>
      <view class="hero-actions">
        <button class="hero-pill" bindtap="onSearch">
          <text class="hero-pill-ico">⌕</text>
          <text>搜索资讯</text>
        </button>
        <button class="hero-pill ghost" bindtap="onNotification">
          <text class="hero-pill-ico">◉</text>
          <text>通知</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 寻迹导航 -->
  <view class="sheet sheet-tight" style="height: 707rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">NAVIGATION</text>
        <text class="sheet-cn">核心导航</text>
      </view>
      <text class="sheet-tip">聚焦比赛演示中最关键的浏览与互动链路</text>
    </view>
    <view class="diamond-grid">
      <view class="diamond-item" bindtap="goNewsList">
        <view class="diamond-icon bg-a">📰</view>
        <text class="diamond-name">新闻列表</text>
        <text class="diamond-sub">资讯聚合</text>
      </view>
      
      <!-- Tab 级别入口（探索 / AR / 我的）改用底部栏承载，这里不再重复 -->
      <view class="diamond-item" bindtap="goNational">
        <view class="diamond-icon bg-d">▣</view>
        <text class="diamond-name">国家级名录</text>
        <text class="diamond-sub">国家级项目</text>
      </view>
      <view class="diamond-item" bindtap="goProvincial">
        <view class="diamond-icon bg-e">▤</view>
        <text class="diamond-name">省级名录</text>
        <text class="diamond-sub">省级项目</text>
      </view>

      <view class="diamond-item" bindtap="goMasterList">
        <view class="diamond-icon bg-j">✦</view>
        <text class="diamond-name">传承人名录</text>
        <text class="diamond-sub">人物档案</text>
      </view>
      <view class="diamond-item" bindtap="goSkillVideo">
        <view class="diamond-icon bg-k">🎬</view>
        <text class="diamond-name">技艺视频</text>
        <text class="diamond-sub">工艺讲解</text>
      </view>
      <view class="diamond-item" bindtap="goActivity">
        <view class="diamond-icon bg-l">📅</view>
        <text class="diamond-name">活动列表</text>
        <text class="diamond-sub">活动报名</text>
      </view>
      <view class="diamond-item" bindtap="goCollection">
        <view class="diamond-icon bg-m">♡</view>
        <text class="diamond-name">我的收藏</text>
        <text class="diamond-sub">个人沉淀</text>
      </view>
      <view class="diamond-item" bindtap="goBooking">
        <view class="diamond-icon bg-n">☰</view>
        <text class="diamond-name">我的预约</text>
        <text class="diamond-sub">到馆体验</text>
      </view>
    </view>
  </view>

  <!-- 精选跳转路线（横向卡片） -->
  <view class="sheet">
    <view class="sheet-head">
      <view class="sheet-head-left">
        <text class="sheet-en">ROUTES</text>
        <text class="sheet-cn">推荐体验路径</text>
      </view>
    </view>
    <scroll-view class="route-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="route-track">
        <view class="route-card r1" bindtap="goFlowNews">
          <text class="route-tag">链 A</text>
          <text class="route-name">资讯深度阅读</text>
          <text class="route-path">首页 → 新闻列表 → 详情</text>
        </view>
        <view class="route-card r2" bindtap="goFlowHeritage">
          <text class="route-tag">链 B</text>
          <text class="route-name">名录与筛选</text>
          <text class="route-path">首页 → 非遗名录页 → 详情</text>
        </view>
        <view class="route-card r3" bindtap="goFlowDetailDirect">
          <text class="route-tag">链 C</text>
          <text class="route-name">精选项目直达</text>
          <text class="route-path">单步进入详情页</text>
        </view>
        <view class="route-card r4" bindtap="goImmersiveDemo">
          <text class="route-tag">链 D</text>
          <text class="route-name">3D沉浸演示</text>
          <text class="route-path">首页 → 3D沉浸 → 模型查看</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 轮播 -->
  <view class="sheet sheet-flush">
    <swiper
      indicator-dots="{{true}}"
      autoplay="{{true}}"
      interval="5200"
      duration="550"
      class="hero-swiper"
      circular="{{true}}"
      indicator-color="rgba(255,255,255,.35)"
      indicator-active-color="#f5e6c8"
    >
      <block wx:for="{{bannerList}}" wx:key="id">
        <swiper-item bindtap="onBannerTap" data-item="{{item}}">
          <view class="swiper-card">
            <image src="{{item.image}}" class="swiper-img" mode="aspectFill" binderror="onBannerImageError" data-index="{{index}}" lazy-load="{{true}}"></image>
            <view class="swiper-mask"></view>
            <view class="swiper-copy">
              <text class="swiper-title">{{item.title}}</text>
              <text class="swiper-desc">{{item.description}}</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 寻迹 · 文化热点：左图右文（近期资讯） -->
  <view class="sheet">
    <view class="sheet-head row-between">
      <view class="sheet-head-left">
        <text class="sheet-en">STORIES</text>
        <text class="sheet-cn">文化热点</text>
      </view>
      <navigator url="/pages/newsList/newsList" class="sheet-more" hover-class="sheet-more-hover">全部</navigator>
    </view>
    <view wx:if="{{newsLoading}}" class="article-loading">
      <text class="article-loading-text">资讯加载中…</text>
    </view>
    <view wx:elif="{{!newsLoading && displayNewsList.length === 0}}" class="article-empty">
      <text class="article-empty-title">暂无资讯</text>
      <text class="article-empty-hint">{{newsLoadError ? '网络异常，请下拉重试' : '稍后再来看看遗韵动态'}}</text>
      <navigator url="/pages/newsList/newsList" class="article-empty-link">前往新闻列表</navigator>
    </view>
    <view wx:else class="article-list">
      <view class="article-row" wx:for="{{displayNewsList}}" wx:key="id" bindtap="onNewsTap" data-item="{{item}}">
        <image src="{{item.image}}" class="article-cover" mode="aspectFill" binderror="onNewsImageError" data-index="{{index}}" lazy-load="{{true}}"></image>
        <view class="article-main">
          <text class="article-title">{{item.title}}</text>
          <text class="article-lead">{{item.description}}</text>
          <view class="article-meta">
            <text class="article-byline">{{item.authorDisplay}} · {{item.relTime}}</text>
            <text class="article-go">阅读全文 →</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 精选非遗：横向滚动 -->
  <view class="sheet">
    <view class="sheet-head row-between">
      <view class="sheet-head-left">
        <text class="sheet-en">PICKS</text>
        <text class="sheet-cn">精选非遗项目</text>
      </view>
    </view>
    <scroll-view class="pick-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="pick-track">
        <view class="pick-card" wx:for="{{recommendList}}" wx:key="id" bindtap="onRecommendTap" data-item="{{item}}">
          <image src="{{item.image}}" class="pick-img" mode="aspectFill" binderror="onRecommendImageError" data-index="{{index}}" lazy-load="{{true}}"></image>
          <view class="pick-body">
            <text class="pick-name">{{item.name}}</text>
            <text class="pick-region">{{item.region}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 3D 通栏 -->
  <view class="ar-cta" bindtap="navigateToARExperience">
    <view class="ar-cta-bg" aria-hidden="true"></view>
    <view class="ar-cta-inner">
      <view class="ar-cta-text">
        <text class="ar-cta-kicker">3D IMMERSIVE</text>
        <text class="ar-cta-title">3D沉浸演示与数字展陈</text>
        <text class="ar-cta-desc">查看三维模型、沉浸项目与体验记录，形成完整的展示闭环。</text>
      </view>
      <view class="ar-cta-btn">进入沉浸页</view>
    </view>
  </view>

  <view class="footer-space"></view>
</view>
