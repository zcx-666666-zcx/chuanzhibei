<!--pages/newsList/newsList.wxml-->
<view class="container">
  <view class="page-header">
    <text class="page-title">{{keyword ? '搜索结果' : '非遗动态'}}</text>
    <text wx:if="{{keyword}}" class="page-sub">关键词：{{keyword}}</text>
  </view>

  <app-state
    wx:if="{{loading}}"
    type="loading"
    title="资讯内容加载中"
    description="{{keyword ? '正在检索与你的关键词相关的内容。' : '正在获取最新非遗动态。'}}"
  />

  <app-state
    wx:elif="{{loadError}}"
    type="error"
    title="资讯加载失败"
    description="{{loadErrorText || '请检查网络连接后重试'}}"
    actionText="重新加载"
    bind:action="onRetryLoad"
  />

  <app-state
    wx:elif="{{newsList.length === 0}}"
    type="empty"
    title="{{keyword ? '未找到相关资讯' : '暂无新闻动态'}}"
    description="{{keyword ? '可以尝试更换关键词重新搜索。' : '稍后再来看看最新内容。'}}"
  />

  <block wx:else>
    <view class="news-list">
      <view
        class="news-card card card-hover"
        wx:for="{{newsList}}"
        wx:key="id"
        bindtap="onNewsTap"
        data-item="{{item}}"
      >
        <image src="{{item.image}}" class="news-img" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="news-content">
          <text class="news-title">{{item.title}}</text>
          <text class="news-desc">{{item.description}}</text>
          <view class="news-footer">
            <text class="news-byline">{{item.authorDisplay}} · {{item.relTime}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="list-footer">
      <text>加载更多…</text>
    </view>
    <view wx:elif="{{!hasMore && newsList.length > 0}}" class="list-footer muted">
      <text>已加载全部 {{total}} 条</text>
    </view>
  </block>
</view>
