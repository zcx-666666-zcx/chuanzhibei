/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  background: var(--rice-paper);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 60rpx 32rpx 40rpx;
}

.content {
  display: flex;
  flex-direction: column;
}

.brand {
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center; /* 让 logo/title/subtitle 在水平方向居中 */
  text-align: center;  /* 让文字居中 */
}
.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  color: #121826;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #5f687a;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 40rpx rgba(18, 24, 38, 0.08);
  overflow: hidden;
}

.tabs {
  display: flex;
  background: #f3f6fb;
  padding: 8rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #6c7487;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.tab.active {
  background: #ffffff;
  color: #121826;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(18, 24, 38, 0.08);
}

.form-content {
  padding: 28rpx 28rpx 26rpx;
}

.input-group {
  margin-bottom: 22rpx;
}

.input-label {
  display: block;
  font-size: 25rpx;
  color: #3a4459;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border-radius: 20rpx;
  border: 1px solid #e6eaf2;
  background: #f9fbff;
  box-sizing: border-box;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #121826;
}

.primary-btn {
  margin-top: 10rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  border: none;
  background: linear-gradient(135deg, var(--primary-red), #e63946);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-btn::after {
  border: none;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
}

.link {
  color: var(--primary-red);
  font-size: 26rpx;
}

.divider {
  color: #b7bfcd;
  margin: 0 12rpx;
  font-size: 24rpx;
}

.muted-text {
  color: #8b94a7;
  font-size: 26rpx;
}

.wechat-area {
  text-align: center;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.wechat-badge {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  margin: 0 auto;
  border-radius: 26rpx;
  background: var(--primary-red);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.wechat-title {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  color: #121826;
  font-weight: 600;
}

.wechat-desc {
  display: block;
  margin-top: 12rpx;
  color: #6f7890;
  font-size: 26rpx;
}

.wechat-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  border: none;
  background: linear-gradient(135deg, var(--primary-red), #e63946);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.wechat-btn::after {
  border: none;
}

.center-link {
  display: inline-block;
  margin-top: 20rpx;
}

.agreement {
  text-align: center;
  font-size: 22rpx;
  color: #97a0b4;
  line-height: 1.7;
  padding: 0 12rpx;
}

.agreement-link {
  color: #6a7387;
  margin: 0 6rpx;
}