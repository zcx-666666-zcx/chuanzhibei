<!--
  纯净 3D：仅模型 + 简单光照 + 轨道相机（无展台/地面/装饰几何体、无 IBL 环境球）
-->
<xr-scene>
  <xr-assets>
    <xr-asset-load type="gltf" asset-id="heroModel" src="{{modelSrc}}" />
  </xr-assets>

  <xr-light type="ambient" color="1 1 1" intensity="0.65" />
  <xr-light type="directional" rotation="32 48 0" color="1 0.99 0.96" intensity="1.35" />

  <xr-node node-id="hero" position="0 0 0">
    <xr-gltf model="heroModel" anim-autoplay scale="0.84 0.84 0.84" />
  </xr-node>

  <xr-camera
    clear-color="0.93 0.905 0.875 1"
    position="0.38 0.52 1.12"
    target="hero"
    camera-orbit-control
  />
</xr-scene>
