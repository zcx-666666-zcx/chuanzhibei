@media (prefers-color-scheme: dark) {
    page {
        background-color: rgb(31, 28, 23);
        color: rgb(239, 227, 219);
    }

    page {
        --primary-red: rgb(243, 104, 94);
        --gold: rgb(109, 80, 0);
        --ink-black: rgb(255, 248, 243);
        --rice-paper: rgb(31, 28, 23);
        --bamboo-green: rgb(81, 134, 49);
        --porcelain-blue: rgb(101, 149, 207);
    }

    .container {
        background-color: rgb(31, 28, 23);
    }

    .card {
        background-color: rgb(17, 17, 17);
    }

    .btn-primary {
        background: rgb(0, 0, 0);
        color: rgb(17, 17, 17);
    }

    .btn-secondary {
        color: rgb(17, 17, 17);
    }

    .btn-secondary:active {
        background-color: rgb(130, 170, 223);
    }

    .text-muted {
        color: rgb(115, 115, 115);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20rpx);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tag {
        background-color: rgb(40, 33, 19);
        color: rgb(160, 129, 86);
    }

    .tag-primary {
        color: rgb(17, 17, 17);
    }

    .tag-secondary {
        color: rgb(17, 17, 17);
    }

    .divider {
        background-color: rgb(28, 28, 28);
    }

    .loading {
        color: rgb(99, 99, 99);
    }

    .empty {
        color: rgb(99, 99, 99);
    }

    .empty-text {
        color: rgb(99, 99, 99);
    }
}
