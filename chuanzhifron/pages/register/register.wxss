/* pages/register/register.wxss */
.page {
  min-height: 100vh;
  background: var(--rice-paper, #f4efe8);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 60rpx 32rpx 40rpx;
}

.content {
  display: flex;
  flex-direction: column;
}

.brand {
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center; /* 让 logo/title/subtitle 在水平方向居中 */
  text-align: center;  /* 让文字居中 */
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  color: #121826;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #5f687a;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 10rpx 40rpx rgba(18, 24, 38, 0.08);
}

.input-group {
  margin-bottom: 22rpx;
}

.input-label {
  display: block;
  font-size: 25rpx;
  color: #3a4459;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border-radius: 20rpx;
  border: 1px solid #e6eaf2;
  background: #f9fbff;
  box-sizing: border-box;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #121826;
}

.primary-btn {
  margin-top: 10rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  border: none;
  background: linear-gradient(135deg, var(--primary-red, #b83232), #c94a4a);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-btn::after {
  border: none;
}

.footer {
  margin-top: 26rpx;
  text-align: center;
}

.footer-text {
  color: #6a7387;
  font-size: 26rpx;
}

.link {
  color: var(--primary-red, #b83232);
  font-size: 26rpx;
  margin-left: 8rpx;
}

.agreement {
  text-align: center;
  font-size: 22rpx;
  color: #97a0b4;
  line-height: 1.7;
  padding: 0 12rpx;
}

.agreement-link {
  color: #6a7387;
  margin: 0 6rpx;
}