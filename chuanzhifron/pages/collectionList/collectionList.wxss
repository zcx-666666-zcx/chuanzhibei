/* pages/collectionList/collectionList.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f5f2;
  padding: 0 30rpx 40rpx;
}

.page-header {
  padding: 30rpx 0;
  background-color: #fff;
  margin: 0 -30rpx 30rpx -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-bottom: 16rpx;
}

.page-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background-color: #c41e3a;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 收藏列表 */
.collection-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.collection-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.collection-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.collection-content {
  flex: 1;
}

.collection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.collection-level {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.collection-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.remove-btn {
  background: none;
  border: none;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.remove-btn:active {
  color: #c41e3a;
}

/* 图标字体 */
.iconfont {
  font-size: 32rpx;
}

.icon-close::before {
  content: '✕';
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .collection-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .collection-image {
    width: 100%;
    height: 200rpx;
    margin-right: 0;
    margin-bottom: 20rpx;
  }
}

