<!--pages/collectionList/collectionList.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的收藏</text>
  </view>

  <!-- 加载状态 -->
  <app-state
    wx:if="{{loading}}"
    type="loading"
    title="收藏列表加载中"
    description="正在整理你已收藏的非遗项目。"
  />

  <app-state
    wx:elif="{{loadError}}"
    type="error"
    title="收藏列表加载失败"
    description="{{loadErrorText || '请检查网络后重试'}}"
    actionText="重新加载"
    bind:action="onRetryLoad"
  />

  <!-- 收藏列表 -->
  <view wx:else class="collection-list">
    <view class="collection-item card card-hover" 
          wx:for="{{collections}}" 
          wx:key="id" 
          bindtap="onCollectionTap" 
          data-item="{{item}}">
      <image src="{{item.image || item.imageUrl}}" class="collection-image" mode="aspectFill" lazy-load="{{true}}"></image>
      <view class="collection-content">
        <text class="collection-title">{{item.name || item.heritageName}}</text>
        <text class="collection-level">{{item.level || item.heritageLevel}}</text>
        <text class="collection-desc">{{item.description || item.heritageDescription}}</text>
      </view>
      
    </view>
  </view>

  <!-- 空状态 -->
  <app-state
    wx:if="{{!loading && !loadError && collections.length === 0}}"
    type="empty"
    title="还没有收藏内容"
    description="浏览非遗项目后可将感兴趣的内容加入收藏。"
  />
</view>
