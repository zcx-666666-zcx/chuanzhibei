.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(184, 50, 50, 0.12), transparent 28%),
    radial-gradient(circle at 90% 12%, rgba(201, 162, 39, 0.1), transparent 20%),
    linear-gradient(180deg, #eee4d4 0%, #f6f0e8 46%, #f4efe8 100%);
  display: flex;
  flex-direction: column;
}

.hero-panel {
  background: linear-gradient(150deg, #2d241d 0%, #1a1410 58%, #443227 100%);
  border-radius: 36rpx;
  padding: 42rpx 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(26, 20, 16, 0.28);
  color: #f8f0e4;
  position: relative;
  overflow: hidden;
}

.hero-panel::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -40rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 245, 224, 0.16) 0%, transparent 70%);
}

.hero-copy,
.hero-badge {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 230, 200, 0.58);
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  font-size: 50rpx;
  line-height: 1.24;
  font-weight: 700;
  color: #fbf5ea;
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(245, 230, 200, 0.82);
}

.hero-badge {
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hero-logo {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.hero-badge-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(248, 240, 228, 0.9);
}

.auth-card {
  margin-top: -22rpx;
  background: rgba(255, 253, 250, 0.96);
  border-radius: 32rpx;
  padding: 34rpx 28rpx 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(45, 33, 24, 0.08);
  border: 1rpx solid rgba(42, 34, 28, 0.06);
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #2a221c;
}

.section-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #81776d;
}

.tabs {
  display: flex;
  padding: 8rpx;
  background: #f0e8dd;
  border-radius: 22rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6e655c;
  border-radius: 18rpx;
}

.tab.active {
  background: #fffdf9;
  color: #2a221c;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(42, 34, 28, 0.06);
}

.form-content {
  display: flex;
  flex-direction: column;
}

.input-group {
  margin-bottom: 22rpx;
}

.input-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #544b43;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border-radius: 22rpx;
  background: #f8f3ec;
  border: 1rpx solid rgba(139, 111, 73, 0.12);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #2a221c;
}

.primary-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(135deg, #b83232 0%, #d3523f 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 28rpx rgba(184, 50, 50, 0.22);
}

.primary-btn::after {
  border: none;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  gap: 18rpx;
}

.meta-link,
.meta-text {
  font-size: 24rpx;
}

.meta-link {
  color: #b83232;
}

.meta-text {
  color: #8b8177;
}

.wechat-area {
  align-items: center;
  text-align: center;
  padding-top: 10rpx;
}

.wechat-mark {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #3b8c54 0%, #4bb164 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.wechat-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2a221c;
}

.wechat-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f756c;
}

.wechat-btn {
  margin-top: 28rpx;
}

.center-link {
  margin-top: 20rpx;
}

.tips-panel {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(120, 96, 66, 0.16);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.tip-label {
  width: 136rpx;
  flex-shrink: 0;
  color: #8d5c2f;
  font-size: 23rpx;
  font-weight: 600;
}

.tip-value {
  flex: 1;
  text-align: right;
  color: #6f665e;
  font-size: 23rpx;
  line-height: 1.5;
}

.agreement {
  margin-top: auto;
  padding-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9a8f83;
  line-height: 1.8;
}

.agreement-link {
  color: #6f665e;
  margin: 0 6rpx;
}
