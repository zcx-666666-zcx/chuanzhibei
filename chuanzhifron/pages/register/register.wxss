.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 8%, rgba(201, 162, 39, 0.12), transparent 20%),
    radial-gradient(circle at 12% 18%, rgba(184, 50, 50, 0.1), transparent 24%),
    linear-gradient(180deg, #ede3d4 0%, #f6f0e8 52%, #f4efe8 100%);
  display: flex;
  flex-direction: column;
}

.hero-panel {
  background: linear-gradient(145deg, #312720 0%, #1a1410 62%, #5a4030 100%);
  border-radius: 34rpx;
  padding: 38rpx 32rpx;
  box-shadow: 0 22rpx 52rpx rgba(26, 20, 16, 0.24);
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 230, 200, 0.58);
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #fbf5ea;
}

.hero-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: rgba(245, 230, 200, 0.82);
}

.form-card {
  margin-top: -16rpx;
  background: rgba(255, 252, 248, 0.97);
  border-radius: 30rpx;
  padding: 30rpx 28rpx 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(45, 33, 24, 0.08);
}

.form-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
  margin-bottom: 28rpx;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.form-head-copy {
  flex: 1;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2a221c;
}

.form-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #81776d;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #544b43;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border-radius: 22rpx;
  background: #f8f3ec;
  border: 1rpx solid rgba(139, 111, 73, 0.12);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #2a221c;
}

.primary-btn {
  margin-top: 12rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(135deg, #b83232 0%, #d3523f 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 28rpx rgba(184, 50, 50, 0.22);
}

.primary-btn::after {
  border: none;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
}

.footer-text,
.footer-link {
  font-size: 25rpx;
}

.footer-text {
  color: #7f756c;
}

.footer-link {
  margin-left: 8rpx;
  color: #b83232;
}

.agreement {
  margin-top: auto;
  padding-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9a8f83;
  line-height: 1.8;
}

.agreement-link {
  color: #6f665e;
  margin: 0 6rpx;
}
