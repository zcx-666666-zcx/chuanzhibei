<view class="xr-wrap xr-wrap--pure">
  <view wx:if="{{modelLoading}}" class="xr-loading">
    <text class="xr-loading-text">{{modelLoadHint || '准备模型…'}}</text>
  </view>
  <view wx:elif="{{modelLoadHint && !selectedModelSrc}}" class="xr-loading">
    <text class="xr-loading-text">{{modelLoadHint}}</text>
  </view>
  <xr-demo-viewer
    wx:if="{{selectedModelSrc}}"
    disable-scroll
    id="xr-frame"
    width="{{renderWidth}}"
    height="{{renderHeight}}"
    modelSrc="{{selectedModelSrc}}"
    style="width:{{width}}px;height:{{height}}px;"
  />
</view>
