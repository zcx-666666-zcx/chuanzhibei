.container {
  min-height: 100vh;
  background: #f8f5f2;
  padding: 24rpx;
}

.loading,
.error {
  text-align: center;
  color: #666;
  padding: 120rpx 0;
}

.error-text {
  display: block;
  margin-bottom: 20rpx;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.avatar {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.meta {
  margin-top: 20rpx;
}

.name {
  display: block;
  font-size: 38rpx;
  color: #222;
  font-weight: 600;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #8a6a44;
  font-size: 26rpx;
}

.skill {
  display: block;
  margin-top: 6rpx;
  color: #555;
  font-size: 26rpx;
}

.intro-box {
  margin-top: 24rpx;
}

.intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.intro-content {
  display: block;
  margin-top: 12rpx;
  line-height: 1.8;
  color: #555;
  font-size: 27rpx;
}
