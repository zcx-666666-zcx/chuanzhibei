.wrap {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: linear-gradient(180deg, #e8dfd4 0%, #f4efe8 100%);
  box-sizing: border-box;
}

.card {
  background: rgba(255, 253, 251, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(42, 34, 28, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2a221c;
  display: block;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 28rpx;
  color: #6a625a;
  line-height: 1.6;
  display: block;
  margin-bottom: 36rpx;
}

.btn {
  background: linear-gradient(135deg, #b83232, #8b2a2a);
  color: #f5e6c8;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
}

.btn::after {
  border: none;
}
